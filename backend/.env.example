# ════════════════════════════════════════════════════════════════════
#  AI Text Summarizer Pro — Environment Configuration Template
#  Copy this file to .env and fill in the values for your environment.
# ════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
PROJECT_NAME="AI Text Summarizer Pro"
ENVIRONMENT=development          # development | staging | production

# ── Security (REQUIRED in production) ────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=supersecret_jwttokens_key_for_development
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 1 week = 7 * 24 * 60

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60          # General API endpoints
AUTH_RATE_LIMIT_PER_MINUTE=10     # Auth endpoints (login, register, OTP)

# ── CORS ────────────────────────────────══════════════════════════
# Comma-separated list of allowed origins. Use * to allow all (dev only).
ALLOWED_ORIGINS=*
# Production example:
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ── Database ──────────────────────────────────────────────────────
# Development: Leave empty or set to sqlite path (auto-detected)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/summarizer_db
# SQLite is used automatically when ENVIRONMENT=development

# ── Redis & Celery ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=

# ── SMTP (Email Notifications) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@summarizer.pro
